  "capture": {
    "tool": "playwright",
    "viewport": {
      "width": 1920,
      "height": 1080
    },
    "deviceScaleFactor": 2,
    "warmup": {
      "method": "GET /",
      "expectStatus": 200,
      "maxWaitSec": 120,
      "note": "render.com 冷啟動 30–90 s，必須預熱"
    },
    "waitRules": [
      "tbody#patchBody tr 數量 > 3 才截圖",
      "#kpiAvgScore 非空才截圖",
      "每次操作後等 150 ms 讓 CSS transition 完成",
      "表格與 KPI 皆為 JS 非同步渲染，禁止固定 sleep 取代 waitFor"
    ],
    "output": [
      "bboxes.json",
      "overview-*.png",
      "patch-*.png",
      "gap-*.png",
      "assess-*.png",
      "result-*.png"
    ],
    "cursorNote": "Playwright 截圖不含 OS 游標；游標為 Remotion 渲染層，座標取自 bboxes.json；hover 高亮是真實渲染",
    "steps": [
      {
        "n": 1,
        "beat": null,
        "action": "warmup",
        "target": "/",
        "waitFor": "HTTP 200"
      },
      {
        "n": 2,
        "beat": 4,
        "action": "goto + settle",
        "target": "/",
        "waitFor": "#kpiAvgScore 有值",
        "shot": "overview-base.png"
      },
      {
        "n": 3,
        "beat": 6,
        "action": "element screenshots",
        "target": "section#overview .panel x4 + 威脅主題分群 + section#matrix",
        "shot": "overview-{i}.png"
      },
      {
        "n": 4,
        "beat": 7,
        "action": "record bboxes",
        "target": "所有後續目標元素",
        "shot": "bboxes.json"
      },
      {
        "n": 5,
        "beat": 40,
        "action": "click tab",
        "target": "button[data-tab=patch]",
        "waitFor": "tbody#patchBody tr > 3",
        "shot": "patch-base.png"
      },
      {
        "n": 6,
        "beat": 54,
        "action": "hover + click",
        "target": "#patchViewAll",
        "waitFor": "tr >= 300 或 3 s 穩定",
        "shot": "patch-expanded.png"
      },
      {
        "n": 7,
        "beat": 56,
        "action": "strip capture",
        "target": "tbody#patchBody scroll container",
        "shot": "strip-{01..20}.png"
      },
      {
        "n": 8,
        "beat": 66,
        "action": "capture only",
        "target": "section#gapSection",
        "forbid": "#gapExpand",
