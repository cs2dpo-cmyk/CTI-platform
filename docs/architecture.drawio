<mxfile host="app.diagrams.net"><diagram name="CTI 資料流"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="n0" value="&lt;b&gt;① 新聞來源&lt;/b&gt;&lt;br&gt;The Hacker News（國際，每月約 250 篇）&lt;br&gt;TWCERT / CC（台灣政府，每月約 5 篇）&lt;br&gt;iThome（台灣媒體，深頁 403 限制）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b2a5b;strokeColor=#3b82f6;fontColor=#c3d0e0;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="30" width="430" height="92" as="geometry"/></mxCell>
<mxCell id="n1" value="&lt;b&gt;② 分層擷取&lt;/b&gt;&lt;br&gt;每月固定 15 篇國際＋5 篇台灣，鋪滿 35 個月" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3320;strokeColor=#22c55e;fontColor=#c3d0e0;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="430" height="64" as="geometry"/></mxCell>
<mxCell id="n2" value="&lt;b&gt;③ 語料庫（SQLite）&lt;/b&gt;&lt;br&gt;788 篇文章 → 去重後 741 件事件&lt;br&gt;抽出 288 個 CVE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3320;strokeColor=#22c55e;fontColor=#c3d0e0;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="222" width="430" height="76" as="geometry"/></mxCell>
<mxCell id="n3" value="&lt;b&gt;④ 情資對照&lt;/b&gt;&lt;br&gt;CVE → EPSS／KEV／CVSS／CWE&lt;br&gt;同時標記「本地通報」（台灣來源）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3320;strokeColor=#22c55e;fontColor=#c3d0e0;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="316" width="430" height="76" as="geometry"/></mxCell>
<mxCell id="n4" value="&lt;b&gt;⑤ 分類 ＋ 評分&lt;/b&gt;&lt;br&gt;規則分類 4 類（每篇附命中規則）&lt;br&gt;加權評分 50／30／12／8 → 0–100 分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3320;strokeColor=#22c55e;fontColor=#c3d0e0;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="410" width="430" height="80" as="geometry"/></mxCell>
<mxCell id="n5" value="&lt;b&gt;⑥ 修補優先級&lt;/b&gt;&lt;br&gt;KEV → P1｜EPSS≥10% 或 CVSS≥9 → P2&lt;br&gt;曝險升／降一級（KEV 不降）&lt;br&gt;P1 131｜P2 134｜P3 23＋SLA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b1d0b;strokeColor=#f97316;fontColor=#c3d0e0;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="508" width="430" height="92" as="geometry"/></mxCell>
<mxCell id="n6" value="&lt;b&gt;⑦ API ＋ 儀表板&lt;/b&gt;&lt;br&gt;FastAPI /api/v1（8 個端點）&lt;br&gt;4 分頁：總覽／修補／評估／情資" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1252;strokeColor=#a855f7;fontColor=#c3d0e0;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="618" width="430" height="86" as="geometry"/></mxCell>
<mxCell id="n7" value="&lt;b&gt;外部官方快照&lt;/b&gt;&lt;br&gt;EPSS 911（利用機率）&lt;br&gt;KEV 1,779（已遭利用）&lt;br&gt;CVSS 704｜CWE 287" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b3b36;strokeColor=#14b8a6;fontColor=#c3d0e0;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="304" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;企業資產清單&lt;/b&gt;&lt;br&gt;14 台示範資產&lt;br&gt;判斷是否對外曝險" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b3b36;strokeColor=#14b8a6;fontColor=#c3d0e0;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="514" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="n9" value="&lt;b&gt;覆蓋缺口&lt;/b&gt;&lt;br&gt;KEV 窗內 711 筆&lt;br&gt;語料只涵蓋 80 筆（11%）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b1d0b;strokeColor=#f97316;fontColor=#c3d0e0;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="316" width="300" height="76" as="geometry"/></mxCell>
<mxCell id="n10" value="&lt;b&gt;即時評估&lt;/b&gt;&lt;br&gt;輸入資產情境 → 分數、劇本&lt;br&gt;what-if：怎麼降級" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b1d0b;strokeColor=#f97316;fontColor=#c3d0e0;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="412" width="300" height="76" as="geometry"/></mxCell>
