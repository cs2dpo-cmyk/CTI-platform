<mxfile host="app.diagrams.net"><diagram name="CTI 資料流"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="n0" value="&lt;b&gt;The Hacker News&lt;/b&gt;&lt;br&gt;國際媒體&lt;br&gt;每月約 250 篇" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b2a5b;strokeColor=#3b82f6;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="210" height="72" as="geometry"/></mxCell>
<mxCell id="n1" value="&lt;b&gt;TWCERT / CC&lt;/b&gt;&lt;br&gt;台灣政府 CERT&lt;br&gt;每月約 5 篇" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b2a5b;strokeColor=#3b82f6;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="40" width="210" height="72" as="geometry"/></mxCell>
<mxCell id="n2" value="&lt;b&gt;iThome&lt;/b&gt;&lt;br&gt;台灣科技媒體&lt;br&gt;深頁 403 限制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b2a5b;strokeColor=#3b82f6;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="40" width="210" height="72" as="geometry"/></mxCell>
<mxCell id="n3" value="&lt;b&gt;外部官方快照&lt;/b&gt;&lt;br&gt;EPSS 911 筆（利用機率）&lt;br&gt;KEV 1,779 筆（已遭利用）&lt;br&gt;CVSS 704 筆（嚴重度）&lt;br&gt;CWE 287 筆（弱點類型）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b3b36;strokeColor=#14b8a6;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="30" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="n4" value="&lt;b&gt;分層擷取&lt;/b&gt;&lt;br&gt;每月固定 15 篇國際 + 5 篇台灣，鋪滿 35 個月&lt;br&gt;（避免語料被最近兩個月塞滿）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3320;strokeColor=#22c55e;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="670" height="72" as="geometry"/></mxCell>
<mxCell id="n5" value="&lt;b&gt;語料庫（SQLite）&lt;/b&gt;&lt;br&gt;788 篇文章 → 去重後 741 件事件&lt;br&gt;抽出 288 個 CVE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3320;strokeColor=#22c55e;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="670" height="72" as="geometry"/></mxCell>
<mxCell id="n6" value="&lt;b&gt;企業資產清單&lt;/b&gt;&lt;br&gt;14 台示範資產&lt;br&gt;判斷是否對外曝險" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b3b36;strokeColor=#14b8a6;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="290" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="n7" value="&lt;b&gt;規則分類（4 類）&lt;/b&gt;&lt;br&gt;漏洞／惡意／研究／產業&lt;br&gt;每篇附命中規則，可稽核" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3320;strokeColor=#22c55e;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="310" height="88" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;情資對照&lt;/b&gt;&lt;br&gt;CVE → EPSS/KEV/CVSS/CWE&lt;br&gt;本地通報（台灣來源）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3320;strokeColor=#22c55e;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="410" width="310" height="88" as="geometry"/></mxCell>
<mxCell id="n9" value="&lt;b&gt;可解釋評分（5 因子）&lt;/b&gt;&lt;br&gt;嚴重度 50%｜利用 30%&lt;br&gt;曝險 12%｜具名 8%&lt;br&gt;→ 0–100 分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d3320;strokeColor=#22c55e;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="310" height="96" as="geometry"/></mxCell>
<mxCell id="n10" value="&lt;b&gt;修補優先級&lt;/b&gt;&lt;br&gt;KEV→P1｜EPSS≥10% 或 CVSS≥9→P2&lt;br&gt;曝險升/降一級（KEV 不降）&lt;br&gt;P1 131｜P2 134｜P3 23" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b1d0b;strokeColor=#f97316;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="540" width="310" height="96" as="geometry"/></mxCell>
<mxCell id="n11" value="&lt;b&gt;覆蓋缺口&lt;/b&gt;&lt;br&gt;KEV 窗內 711 筆中&lt;br&gt;語料只涵蓋 80 筆（11%）&lt;br&gt;→ 631 筆未收錄清單" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b1d0b;strokeColor=#f97316;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="540" width="340" height="96" as="geometry"/></mxCell>
<mxCell id="n12" value="&lt;b&gt;即時評估（單一情境）&lt;/b&gt;&lt;br&gt;輸入資產、曝險、控制項 → 分數、等級、處置劇本&lt;br&gt;what-if：加哪一項控制可降級" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b1d0b;strokeColor=#f97316;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="655" height="80" as="geometry"/></mxCell>
<mxCell id="n13" value="&lt;b&gt;FastAPI /api/v1（8 個端點）&lt;/b&gt;&lt;br&gt;/stats｜/threats｜/patch-priority｜/kev-uncovered｜/cve/{id}｜/assess" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1252;strokeColor=#a855f7;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1020" height="62" as="geometry"/></mxCell>
<mxCell id="n14" value="&lt;b&gt;儀表板（4 個分頁）&lt;/b&gt;&lt;br&gt;總覽｜修補清單（含弱點類型篩選）｜即時評估｜情資流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#64748b;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1020" height="72" as="geometry"/></mxCell>
